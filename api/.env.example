PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/envguard
JWT_SECRET=generate-random-64-char-string-in-production-must-be-secure
JWT_EXPIRES_IN=7d
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-google-app-password
SMTP_FROM=EnvGuard <noreply@yourdomain.com>
CORS_ORIGIN=http://localhost:3000
PROJECTS_PAGE_LIMIT=6
VARIABLES_PAGE_LIMIT=10
HISTORY_PAGE_LIMIT=8
MEMBERS_PAGE_LIMIT=5
ACTIVITY_RETENTION_DAYS=7
