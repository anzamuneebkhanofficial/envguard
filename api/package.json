{
  "name": "envguard-api",
  "version": "1.0.0",
  "description": "EnvGuard API Server - Environment Variable Tracker & Drift Guard",
  "type": "module",
  "main": "dist/src/server.js",
  "bin": {
    "envg-upload": "./dist/cli/envg-upload.js",
    "envguard-sync-example": "./dist/cli/sync-example.js"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/src/server.js",
    "typecheck": "tsc --noEmit",
    "cli:upload": "tsx cli/envg-upload.ts",
    "cli:sync-example": "tsx cli/sync-example.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.0.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.12.1",
    "nodemailer": "^6.10.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/node": "^22.13.8",
    "@types/nodemailer": "^6.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
